# deploy/compose/topology.env -- the single source of addresses, ports and names.
# LOCAL_TEST_ONLY / NOT_QUALIFIED. Read by compose, the PKI generator, the contract
# renderer, the lint and the smoke test. Shell-sourceable KEY=value, no secrets.
# Addresses follow spec docs/superpowers/specs/2026-10-21-docker-compose-two-cell-design.md 3.2.

# --- cells and networks -------------------------------------------------------
CELLS="c001 c002"
NET_C001=172.30.1.0/24
NET_C002=172.30.2.0/24
NET_SHARED=172.30.0.0/24

# --- shared network (net-shared) ---------------------------------------------
CONTROL_IP=172.30.0.10
IDENTITY_IP=172.30.0.11
PLATFORM_IP=172.30.0.12
PG_DIRECTORY_IP=172.30.0.14
GATEWAY_C001_IP=172.30.0.21
GATEWAY_C002_IP=172.30.0.22

# --- actors: net-<cell> address (Artery 25520, management 8558) and net-shared address
ACTOR_C001_1_CELL_IP=172.30.1.11
ACTOR_C001_2_CELL_IP=172.30.1.12
ACTOR_C001_3_CELL_IP=172.30.1.13
ACTOR_C001_4_CELL_IP=172.30.1.14
ACTOR_C001_5_CELL_IP=172.30.1.15
ACTOR_C001_6_CELL_IP=172.30.1.16
ACTOR_C001_1_SHARED_IP=172.30.0.31
ACTOR_C001_2_SHARED_IP=172.30.0.32
ACTOR_C001_3_SHARED_IP=172.30.0.33
ACTOR_C001_4_SHARED_IP=172.30.0.34
ACTOR_C001_5_SHARED_IP=172.30.0.35
ACTOR_C001_6_SHARED_IP=172.30.0.36
ACTOR_C002_1_CELL_IP=172.30.2.11
ACTOR_C002_2_CELL_IP=172.30.2.12
ACTOR_C002_3_CELL_IP=172.30.2.13
ACTOR_C002_4_CELL_IP=172.30.2.14
ACTOR_C002_5_CELL_IP=172.30.2.15
ACTOR_C002_6_CELL_IP=172.30.2.16
ACTOR_C002_1_SHARED_IP=172.30.0.41
ACTOR_C002_2_SHARED_IP=172.30.0.42
ACTOR_C002_3_SHARED_IP=172.30.0.43
ACTOR_C002_4_SHARED_IP=172.30.0.44
ACTOR_C002_5_SHARED_IP=172.30.0.45
ACTOR_C002_6_SHARED_IP=172.30.0.46

# Availability-zone role per actor: actors 1-3 az-a, 4-6 az-b (3+3 per cell).
ACTOR_C001_1_AZ=az-a
ACTOR_C001_2_AZ=az-a
ACTOR_C001_3_AZ=az-a
ACTOR_C001_4_AZ=az-b
ACTOR_C001_5_AZ=az-b
ACTOR_C001_6_AZ=az-b
ACTOR_C002_1_AZ=az-a
ACTOR_C002_2_AZ=az-a
ACTOR_C002_3_AZ=az-a
ACTOR_C002_4_AZ=az-b
ACTOR_C002_5_AZ=az-b
ACTOR_C002_6_AZ=az-b

# --- per-cell PostgreSQL and fake kube-API (net-<cell>) -----------------------
PG_C001_PRIMARY_IP=172.30.1.101
PG_C001_STANDBY_IP=172.30.1.102
PG_C002_PRIMARY_IP=172.30.2.101
PG_C002_STANDBY_IP=172.30.2.102
KUBE_C001_IP=172.30.1.250
KUBE_C002_IP=172.30.2.250
# control joins both cell networks to reach the three PostgreSQL (spec 3.2); the
# address table lists no cell-net address for it, the free .10 host is used.
CONTROL_C001_IP=172.30.1.10
CONTROL_C002_IP=172.30.2.10
KUBE_C001_NAMESPACE=wsa-c001
KUBE_C002_NAMESPACE=wsa-c002

# --- ports --------------------------------------------------------------------
RPC_PORT=8443
RELAY_PORT=9443
SOURCE_PORT=9443
ADMIN_PORT=9444
HEALTH_PORT=8559
# published on the host
GATEWAY_PUBLISH_C001=8443
GATEWAY_PUBLISH_C002=8444
CONTROL_PUBLISH=8445
IDENTITY_PUBLISH=8081

# --- names (resolved to 127.0.0.1 through /etc/hosts; see hosts.sh) ------------
HOSTNAME_C001=c001.signaling.local
HOSTNAME_C002=c002.signaling.local
HOSTNAME_BOOTSTRAP=bootstrap.signaling.local
HOSTNAME_IDENTITY=identity.signaling.local
ORIGIN=https://app.signaling.local

# --- identity -----------------------------------------------------------------
ISSUER=http://identity.signaling.local:8081
AUDIENCE=webrtc-signaling

# --- gateways and identifiers ---------------------------------------------------
GATEWAY_ID_C001=gw-c001-a
GATEWAY_ID_C002=gw-c002-a

# TEST_ONLY fixed 64-hex identifiers (lower case). Derivation, so they can be re-checked:
#   printf 'TEST_ONLY_COMPOSE_CLUSTER_FINGERPRINT_c001' | sha256sum
#   printf 'TEST_ONLY_COMPOSE_CLUSTER_FINGERPRINT_c002' | sha256sum
#   printf 'TEST_ONLY_COMPOSE_EXECUTABLE_ID' | sha256sum
CLUSTER_FINGERPRINT_C001=8bb309a73f6d94bb7c7b1b2ffda147415680b055ee1623e258adf798a541798c
CLUSTER_FINGERPRINT_C002=9e64d44af205b916955cde2eeef920ad64f34ed3ce57ced626b9b83c8671bceb
EXECUTABLE_ID=952840cc38e1762e043c27338fff0393ee343fabfbd78226cab94f5765a3645a

# --- directory bucket split ------------------------------------------------------
SPLIT=8192

# --- account user ids ------------------------------------------------------------
# Deliberately UNSET here. Task 6 (identity accounts) fills these in once the
# bucket -> cell mapping is pinned by test:
#   ACCOUNT_ADMIN_USER_ID=
#   ACCOUNT_MOD_USER_ID=
