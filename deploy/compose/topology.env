# deploy/compose/topology.env -- the single source of addresses, ports and names.
# LOCAL_TEST_ONLY / NOT_QUALIFIED. Read by compose, the PKI generator, the contract
# renderer, the lint and the smoke test. Shell-sourceable KEY=value, no secrets.
# Addresses follow spec docs/superpowers/specs/2026-10-21-docker-compose-two-cell-design.md 3.2.

# --- cells and networks -------------------------------------------------------
CELLS="c001 c002"
# Actors per cell. Production is six; this LOCAL_TEST_ONLY environment declares three (a cell is
# business-ready on a strict majority: two of three). The actors read it as
# SIGNALING_LOCAL_CELL_ACTORS; spec 2026-10-21-docker-compose-two-cell-design.md 3.1.
ACTORS_PER_CELL=3
NET_C001=172.30.1.0/24
NET_C002=172.30.2.0/24
NET_SHARED=172.30.0.0/24
# Ranges Docker hands out dynamically (compose ipam ip_range); only provision-2 takes a dynamic
# address. Every static address below lies outside them, so a one-shot container can never take
# an address a later service needs (pg-directory admits control and local-platform by /32).
NET_C001_DYNAMIC=172.30.1.192/27
NET_C002_DYNAMIC=172.30.2.192/27
NET_SHARED_DYNAMIC=172.30.0.192/27
# The host's address on net-shared (the bridge gateway), pinned instead of left to Docker. Host-side
# callers such as the smoke reach local-platform from it; local-platform maps it in /etc/hosts
# because its JDK HttpsServer reverse-resolves every TLS peer and Docker's DNS has no PTR for it.
NET_SHARED_GATEWAY=172.30.0.192

# --- shared network (net-shared) ---------------------------------------------
CONTROL_IP=172.30.0.10
IDENTITY_IP=172.30.0.11
PLATFORM_IP=172.30.0.12
PG_DIRECTORY_IP=172.30.0.14
GATEWAY_C001_IP=172.30.0.21
GATEWAY_C002_IP=172.30.0.22

# --- actors: net-<cell> address (Artery 25520, management 8558) and net-shared address
ACTOR_C001_1_CELL_IP=172.30.1.11
ACTOR_C001_2_CELL_IP=172.30.1.12
ACTOR_C001_3_CELL_IP=172.30.1.13
ACTOR_C001_1_SHARED_IP=172.30.0.31
ACTOR_C001_2_SHARED_IP=172.30.0.32
ACTOR_C001_3_SHARED_IP=172.30.0.33
ACTOR_C002_1_CELL_IP=172.30.2.11
ACTOR_C002_2_CELL_IP=172.30.2.12
ACTOR_C002_3_CELL_IP=172.30.2.13
ACTOR_C002_1_SHARED_IP=172.30.0.41
ACTOR_C002_2_SHARED_IP=172.30.0.42
ACTOR_C002_3_SHARED_IP=172.30.0.43

# Availability-zone role per actor: one zone each, az-a / az-b / az-c. Losing any one actor leaves two
# zones, which the compatibility window needs.
ACTOR_C001_1_AZ=az-a
ACTOR_C001_2_AZ=az-b
ACTOR_C001_3_AZ=az-c
ACTOR_C002_1_AZ=az-a
ACTOR_C002_2_AZ=az-b
ACTOR_C002_3_AZ=az-c

# --- per-cell PostgreSQL and fake kube-API (net-<cell>) -----------------------
PG_C001_PRIMARY_IP=172.30.1.101
PG_C001_STANDBY_IP=172.30.1.102
PG_C002_PRIMARY_IP=172.30.2.101
PG_C002_STANDBY_IP=172.30.2.102
KUBE_C001_IP=172.30.1.250
KUBE_C002_IP=172.30.2.250
# control joins both cell networks to reach the three PostgreSQL (spec 3.2); the
# address table lists no cell-net address for it, the free .10 host is used.
CONTROL_C001_IP=172.30.1.10
CONTROL_C002_IP=172.30.2.10
KUBE_C001_NAMESPACE=wsa-c001
KUBE_C002_NAMESPACE=wsa-c002

# --- ports --------------------------------------------------------------------
RPC_PORT=8443
RELAY_PORT=9443
SOURCE_PORT=9443
ADMIN_PORT=9444
HEALTH_PORT=8559
# inside the compose networks: every PostgreSQL, and the fake kube-API of each cell
PG_PORT=5432
KUBE_API_PORT=443
# published on the host, bound to loopback only (the /etc/hosts names point at 127.0.0.1)
PUBLISH_HOST=127.0.0.1
GATEWAY_PUBLISH_C001=8443
GATEWAY_PUBLISH_C002=8444
CONTROL_PUBLISH=8445
IDENTITY_PUBLISH=8081

# --- names (resolved to 127.0.0.1 through /etc/hosts; see hosts.sh) ------------
# Internal DNS suffix of the certificate names and TLS authorities (actor.<cell>.$DOMAIN,
# gateway.<cell>.$DOMAIN, local-platform.$DOMAIN): stage-1 PKI and the contract renderer read it
# from here, so a SAN and the name a client checks cannot drift apart.
DOMAIN=signaling.local
HOSTNAME_C001=c001.signaling.local
HOSTNAME_C002=c002.signaling.local
HOSTNAME_BOOTSTRAP=bootstrap.signaling.local
HOSTNAME_IDENTITY=identity.signaling.local
ORIGIN=https://app.signaling.local

# --- identity -----------------------------------------------------------------
ISSUER=http://identity.signaling.local:8081
AUDIENCE=webrtc-signaling

# --- gateways and identifiers ---------------------------------------------------
GATEWAY_ID_C001=gw-c001-a
GATEWAY_ID_C002=gw-c002-a

# TEST_ONLY fixed 64-hex identifiers (lower case). Derivation, so they can be re-checked:
#   printf 'TEST_ONLY_COMPOSE_CLUSTER_FINGERPRINT' | sha256sum
#   printf 'TEST_ONLY_COMPOSE_EXECUTABLE_ID' | sha256sum
# ONE cluster fingerprint for both cells: the compatibility gates (CompatibilityWindow.accepts,
# NativeCompatibility.permitsGateway, NativeCompatibilityCollectors.validate) require a peer's
# fingerprint to equal this build's, so per-cell values would fail every cross-cell INVITE and
# relay closed. Spec 4.2's "same within a cell" is a lower bound, not a per-cell value.
CLUSTER_FINGERPRINT=f969d42263eb4de10102c88c4a0000bf3b932b52c8e8adfa1550e568c69a9037
EXECUTABLE_ID=952840cc38e1762e043c27338fff0393ee343fabfbd78226cab94f5765a3645a

# --- directory bucket split ------------------------------------------------------
SPLIT=8192

# --- account user ids ------------------------------------------------------------
# TEST_ONLY identity users (the committed signaling-identity test accounts admin/mod). Their cell is
# fixed by SessionRegistryService.bucket(userId) against SPLIT (bucket < SPLIT -> c001, else c002) so
# the two smoke users live in DIFFERENT cells (spec 7 step 2). Pinned by ComposeUserBucketsTest.
#   admin  6acdfd9e63f4055d3f6672d4  bucket 3502   -> c001
#   mod    6acdfda663f4055d3f6672d7  bucket 10942  -> c002   (the identity module's own default id)
# The identity default for admin (...72d3, bucket 11820) is also c002, so only admin was changed: the
# first id after it, counting the last byte up from d3, that lands below SPLIT is ...72d4. Re-check:
#   printf '%s' 6acdfd9e63f4055d3f6672d4 | sha256sum   # bucket = (byte6 & 63) << 8 | byte7
ACCOUNT_ADMIN_USER_ID=6acdfd9e63f4055d3f6672d4
ACCOUNT_MOD_USER_ID=6acdfda663f4055d3f6672d7
