# deploy/compose/.env.example -- image references and JVM options. LOCAL_TEST_ONLY / NOT_QUALIFIED.
# Copy to deploy/compose/.env (git-ignored) and use both files:
#   docker compose --env-file deploy/compose/topology.env --env-file deploy/compose/.env \
#     -f deploy/compose/compose.yaml ...
# No secrets: every key, password and token is generated at run time into the `run` volume.

# Own images, built from this checkout (`make build`); the tag is local and mutable, the build
# commit is recorded in the image label org.opencontainers.image.revision.
APP_IMAGE=signaling-app:local
IDENTITY_IMAGE=signaling-identity:local
PLATFORM_IMAGE=signaling-local-platform:local
PROVISIONER_IMAGE=signaling-provisioner:local
# kube-api is built FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
# (pinned in deploy/compose/kube-api/Dockerfile).
KUBE_API_IMAGE=signaling-kube-api:local

# Third-party image, pulled: digest pinned (resolved 2026-10-22 from the local postgres:17.6 pull).
POSTGRES_IMAGE=postgres:17.6@sha256:00bc86618629af00d2937fdc5a5d63db3ff8450acf52f0636ec813c7f4902929

# JVM options of every JVM service (planes via launch.sh, identity and local-platform via
# JDK_JAVA_OPTIONS). Heap size is a starting point; Task 10 measures and adjusts it.
JVM_OPTS=-Xms256m -Xmx384m -XX:+ExitOnOutOfMemoryError
