        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (increase(signaling_recovery_successful_total{sli=\"ACTIVE_CALL_PRESERVATION\"}[1h])) / sum by (cell) (increase(signaling_recovery_eligible_total{sli=\"ACTIVE_CALL_PRESERVATION\"}[1h]))"
        }
      ]
    },
    {
      "id": 7,
