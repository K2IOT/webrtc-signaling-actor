      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (increase(signaling_recovery_successful_total{sli=\"SIGNALING_REATTACHMENT\"}[1h])) / sum by (cell) (increase(signaling_recovery_eligible_total{sli=\"SIGNALING_REATTACHMENT\"}[1h]))"
        }
