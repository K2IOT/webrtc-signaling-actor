{
  "uid": "signaling-v1",
  "title": "Signaling control and recovery",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "signaling"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Control latency 0.95",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,operation,cell) (rate(signaling_operation_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Control latency 0.99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,operation,cell) (rate(signaling_operation_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Control latency 0.999",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.999, sum by (le,operation,cell) (rate(signaling_operation_latency_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Eligible control failures / 99.95% request SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(signaling_operation_total{result_class=\"SERVICE_FAILURE\"}[5m])) / clamp_min(sum(rate(signaling_operation_total{outcome!~\"USER_BUSY|CALL_ENDED|TOKEN_EXPIRED|FORBIDDEN|STALE_VERSION\"}[5m])),0.001)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "WORKFLOW_CONVERGENCE",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (increase(signaling_recovery_successful_total{sli=\"WORKFLOW_CONVERGENCE\"}[1h])) / sum by (cell) (increase(signaling_recovery_eligible_total{sli=\"WORKFLOW_CONVERGENCE\"}[1h]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
